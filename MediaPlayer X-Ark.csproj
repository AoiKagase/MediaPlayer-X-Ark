<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0-windows7.0</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>MediaPlayer_X_Ark</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWindowsForms>true</UseWindowsForms>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<StartupObject>MediaPlayer_X_Ark.Program</StartupObject>
		<PlatformTarget>x64</PlatformTarget>
		<Authors>Aoi.Kagase</Authors>
		<AssemblyName>x-ark</AssemblyName>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
		<DebugType>embedded</DebugType>
		<SignAssembly>False</SignAssembly>
		<IsPublishable>True</IsPublishable>
		<Platforms>AnyCPU;x64</Platforms>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\Icons\x-ark-icon.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Resources\Skins\Temp\**" />
		<EmbeddedResource Remove="Resources\Skins\Temp\**" />
		<None Remove="Resources\Skins\Temp\**" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Remove="Controls\SpectrumAnalyzer - Copy.cs" />
	  <Compile Remove="Controls\SpectrumAnalyzer - コピー.cs" />
	  <Compile Remove="Controls\SpectrumAnalyzer - コピー.Designer.cs" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Remove="Controls\SpectrumAnalyzer - コピー.resx" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="Forms\_OptionsForm.bak" />
	  <None Remove="Forms\_OptionsForm.Designer.bak" />
	  <None Remove="Forms\_OptionsForm.resx.bak" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Resources\fmod.dll" />
		<Content Include="Resources\Attribution\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Remove="Resources\Attribution\FMOD_Logo_Black_Transparent.png" />
		<Content Include="Resources\Icons\x-ark-icon.ico" />
		<Content Remove="Resources\Icons\x-ark-icon.png" />
		<Content Remove="Resources\Brand\media-player-x-ark-logo.png" />
		<EmbeddedResource Include="Resources\Attribution\FMOD_Logo_Black_Transparent.png" />
		<EmbeddedResource Include="Resources\Icons\x-ark-icon.png" />
		<EmbeddedResource Include="Resources\Brand\media-player-x-ark-logo.png" />
		<Content Include="Resources\Skins\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Docs\help.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\Plugins" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="nfluidsynth" Version="0.3.1" />
		<PackageReference Include="System.Data.DataSetExtensions" Version="4.6.0-preview3.19128.7" />
		<PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
		<PackageReference Include="z440.atl.core" Version="7.11.0" />
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="Build">
		<ItemGroup>
			<ResourceDlls Include="Resources\*.dll" />
			<SkinFiles Include="Resources\Skins\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ResourceDlls)" DestinationFolder="$(OutputPath)" />
		<Copy SourceFiles="@(SkinFiles)" DestinationFolder="$(OutputPath)Skins\%(RecursiveDir)" />
	</Target>
	<Target Name="MoveLibs" AfterTargets="Build">
		<MakeDir Directories="$(OutputPath)Libs" />
		<ItemGroup>
			<VorticeDlls Include="$(OutputPath)Vortice.*.dll;$(OutputPath)SharpGen.*.dll" />
		</ItemGroup>
		<Move SourceFiles="@(VorticeDlls)" DestinationFolder="$(OutputPath)Libs\" Condition="'@(VorticeDlls)' != ''" />
		<Move SourceFiles="$(OutputPath)fmod.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)fmod.dll')" />
		<Move SourceFiles="$(OutputPath)XArkMidiEngine.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)XArkMidiEngine.dll')" />
		<Move SourceFiles="$(OutputPath)AlacEncoder.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)AlacEncoder.dll')" />
		<Move SourceFiles="$(OutputPath)FlacEncoder.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)FlacEncoder.dll')" />
		<Move SourceFiles="$(OutputPath)SRLAEncoder.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)SRLAEncoder.dll')" />
		<Move SourceFiles="$(OutputPath)ATL.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)ATL.dll')" />
		<Move SourceFiles="$(OutputPath)Ude.NetStandard.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)Ude.NetStandard.dll')" />
		<Move SourceFiles="$(OutputPath)NFluidsynth.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)NFluidsynth.dll')" />
		<Move SourceFiles="$(OutputPath)NFluidsynth.MidiAccess.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)NFluidsynth.MidiAccess.dll')" />
		<Move SourceFiles="$(OutputPath)DiscordRPC.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)DiscordRPC.dll')" />
		<Move SourceFiles="$(OutputPath)Newtonsoft.Json.dll" DestinationFolder="$(OutputPath)Libs\" Condition="Exists('$(OutputPath)Newtonsoft.Json.dll')" />
		<!-- ロケールリソース（不要） -->
		<RemoveDir Directories="$(OutputPath)de-DE" Condition="Exists('$(OutputPath)de-DE')" />
		<RemoveDir Directories="$(OutputPath)ru-RU" Condition="Exists('$(OutputPath)ru-RU')" />
	</Target>
</Project>
